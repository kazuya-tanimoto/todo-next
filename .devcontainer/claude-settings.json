{
  "model": "opus[1m]",
  "outputStyle": "concise-ja",
  "feedbackDrafts": "off",
  "feedbackSurveyRate": 0,
  "effortLevel": "xhigh",
  "tui": "fullscreen",
  "remoteControlAtStartup": true,
  "statusLine": {
    "type": "command",
    "command": "/home/node/.claude/statusline.sh"
  },
  "permissions": {
    "allow": ["WebFetch", "WebSearch"],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf $HOME*)",
      "Bash(sudo *)",
      "Bash(chmod -R *)",
      "Bash(curl * | sh)",
      "Bash(curl * | bash)",
      "Bash(wget * | sh)",
      "Bash(wget * | bash)"
    ],
    "ask": ["Bash(git push *)", "Bash(git push)"]
  }
}
