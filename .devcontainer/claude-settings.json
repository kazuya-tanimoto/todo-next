{
  "model": "opus[1m]",
  "outputStyle": "concise-ja",
  "effortLevel": "xhigh",
  "tui": "fullscreen",
  "remoteControlAtStartup": true,
  "statusLine": {
    "type": "command",
    "command": "/home/node/.claude/statusline.sh"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.devcontainer/herdr/agent-state.sh\" idle",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.devcontainer/herdr/agent-state.sh\" working",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.devcontainer/herdr/agent-state.sh\" idle",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.devcontainer/herdr/agent-state.sh\" blocked",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.devcontainer/herdr/agent-state.sh\" working",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.devcontainer/herdr/agent-state.sh\" clear",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": ["WebFetch", "WebSearch"],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf $HOME*)",
      "Bash(sudo *)",
      "Bash(chmod -R *)",
      "Bash(curl * | sh)",
      "Bash(curl * | bash)",
      "Bash(wget * | sh)",
      "Bash(wget * | bash)"
    ],
    "ask": ["Bash(git push *)", "Bash(git push)"]
  }
}
